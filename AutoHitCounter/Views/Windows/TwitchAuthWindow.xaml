<Window x:Class="AutoHitCounter.Views.Windows.TwitchAuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect to Twitch"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="380"
        MinHeight="200"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Border Background="{DynamicResource InputBackgroundBrush}"
            BorderBrush="{DynamicResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.5" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBrush}"
                    CornerRadius="3,3,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText"
                           Text="Connect to Twitch"
                           Foreground="{DynamicResource TitleTextBrush}"
                           FontWeight="SemiBold"
                           Margin="10,6" />
            </Border>

            <StackPanel Grid.Row="1" Margin="15">
                <TextBlock Text="Enter this code on twitch.tv to let Auto Hit Counter change your category."
                           Foreground="{DynamicResource InputTextBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12" />

                <Border Background="{DynamicResource ControlBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3"
                        Padding="10,8"
                        Margin="0,0,0,10">
                    <TextBox x:Name="CodeText"
                             Text=""
                             IsReadOnly="True"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource InputTextBrush}"
                             FontFamily="Consolas"
                             FontSize="22"
                             FontWeight="Bold"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center" />
                </Border>

                <TextBlock x:Name="UriText"
                           Text=""
                           Foreground="#777"
                           FontSize="11"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,10" />

                <TextBlock x:Name="StatusText"
                           Text="Waiting for authorization..."
                           Foreground="{DynamicResource InputTextBrush}"
                           FontStyle="Italic"
                           FontSize="11"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="10,5,10,10">
                <Button x:Name="OpenButton"
                        Content="Open Twitch"
                        Width="110"
                        Height="26"
                        Margin="0,0,8,0"
                        Click="OpenButton_Click" />
                <Button x:Name="CancelButton"
                        Content="Cancel"
                        Width="75"
                        Height="26"
                        Click="CancelButton_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
